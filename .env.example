# Copy to .env and supply your own local database credentials.
DB_NAME=upoharlab
DB_USER=upoharlab
DB_PASSWORD=
APP_PORT=8080
# Used only for running Maven on the host; Compose uses postgres:5432.
DB_HOST_PORT=5433
# Required only on the first admin bootstrap. Use a private password of 12–72 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional Phase 3 alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
