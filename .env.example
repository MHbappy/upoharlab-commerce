# Copy to .env and supply your own local database credentials.
DB_NAME=upoharlab
DB_USER=upoharlab
DB_PASSWORD=
APP_PORT=8080
# Used only for running Maven on the host; Compose uses postgres:5432.
DB_HOST_PORT=5433
# Required only on the first admin bootstrap. Use a private password of 12–72 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# New orders allowed per hour from one IP address.
ORDERS_PER_HOUR=5
# Site address, used for the admin link in alerts. Example: https://upoharlab.com
APP_BASE_URL=
# Optional owner alerts for new orders.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Production only (compose.prod.yaml). See DEPLOY.md.
SITE_DOMAIN=
BACKUP_DIR=/var/backups/upoharlab
# Private rclone destination for off-server copies. Example: mydrive:upoharlab-backups
BACKUP_REMOTE=
APP_MEMORY_LIMIT=640m
